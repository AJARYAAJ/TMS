PORT=3000
DATABASE_URL=postgres://workora:workora@localhost:5432/workora
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
# Encrypts 2FA and SSO secrets at rest (AES-256-GCM). Defaults to a key derived from JWT_SECRET.
ENCRYPTION_KEY=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:5173
STORAGE_ROOT=./data/uploads
STORAGE_SIGNING_SECRET=change-me-too
RATE_LIMIT_PER_MINUTE=600
# Public URL of the web app, used for links in Slack messages
APP_URL=http://localhost:5173/workora
# Public URL of the API, used for one-click unsubscribe links and the SSO redirect URI (default: APP_URL origin + /api/v1)
# API_PUBLIC_URL=https://workora.example.com/api/v1

# Email: without SMTP settings, emails are rendered and logged but not sent.
# Local dev: `docker compose up mailpit` and open http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Or discrete settings (smtps:// or SMTP_SECURE=true for port 465):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_REQUIRE_TLS=true
MAIL_FROM="Workora <no-reply@example.com>"
